<UserControl x:Class="Event_Management.View.EventUserController"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Event_Management.View"
             mc:Ignorable="d" 
             d:DesignHeight="700" 
             d:DesignWidth="1000">

    <!-- Resources for consistent styling -->
    <UserControl.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="SubHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="DescriptionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="CardValueGreenStyle" TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
            <Setter Property="Foreground" Value="#059669"/>
        </Style>

        <Style x:Key="FilterControlStyle" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FilterControlStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FilterControlStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled">
        <Border Background="White">
            <StackPanel Background="White" 
            Margin="24">

                <!-- PAGE HEADER SECTION -->
                <StackPanel Margin="0,0,0,32">
                    <StackPanel Orientation="Horizontal" 
                    Margin="0,0,0,16">
                        <TextBlock Text="Events" 
                       Style="{StaticResource HeaderTextStyle}"/>
                        <Button Content="+ Add New Event"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="150"
                    Margin="24,0,0,0"
                   />
                    </StackPanel>

                    <TextBlock Text="Manage all your events and select one to view related data"
                   Style="{StaticResource DescriptionTextStyle}"/>
                </StackPanel>

                <!-- DASHBOARD SUMMARY SECTION -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="Overview" 
                   Style="{StaticResource SubHeaderTextStyle}"/>

                    <UniformGrid Columns="4" 
                     Margin="0,0,0,0">
                        <!-- Total Events Card -->
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Total Events" 
                               Style="{StaticResource CardLabelStyle}"/>
                                <TextBlock x:Name="TotalEventsText" 
                               Style="{StaticResource CardValueStyle}" Text="{Binding TotalEventCount}"/>
                            </StackPanel>
                        </Border>

                        <!-- Upcoming Events Card -->
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Upcoming" 
                               Style="{StaticResource CardLabelStyle}"/>
                                <TextBlock x:Name="UpcomingEventsText" 
                               Style="{StaticResource CardValueStyle}" Text="{Binding UpcomingEventCount}"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Guests Card -->
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Total Guests" 
                               Style="{StaticResource CardLabelStyle}"/>
                                <TextBlock x:Name="TotalGuestsText" 
                               Style="{StaticResource CardValueGreenStyle}" Text="{Binding TotalGuests}"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Budget Card -->
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Total Budget" 
                               Style="{StaticResource CardLabelStyle}"/>
                                <TextBlock x:Name="TotalBudgetText" 
                               Style="{StaticResource CardValueGreenStyle}" Text="{Binding TotalBudget}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- FILTERS & SEARCH SECTION -->
                <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left" >

                    <!-- Search -->
                    <StackPanel Margin="10,0" Width="250">
                        <TextBlock Text="Search Events:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                 Padding="4" />
                    </StackPanel>

                    <!-- Status Filter -->
                    <StackPanel Margin="10,0" Width="200">
                        <TextBlock Text="Filter by Status:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding StatusList}"
                  SelectedItem="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}"
                  Padding="4" />
                    </StackPanel>

                    <!-- Type Filter -->
                    <StackPanel Margin="10,0" Width="200">
                        <TextBlock Text="Filter by Type:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding TypeList}"
                  SelectedItem="{Binding SelectedType, UpdateSourceTrigger=PropertyChanged}"
                  Padding="4" />
                    </StackPanel>

                </StackPanel>





                <UserControl >
                    <UserControl.Resources>
                        <!-- STYLES -->
                        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="#374151"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="12,8"/>
                        </Style>

                        <Style x:Key="DataTextStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="#6B7280"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="Margin" Value="12,0"/>
                        </Style>

                        <Style x:Key="NameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DataTextStyle}">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="#1F2937"/>
                        </Style>

                        <Style x:Key="StatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DataTextStyle}">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#374151"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Upcoming">
                                    <Setter Property="Foreground" Value="#4361EE"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Ongoing">
                                    <Setter Property="Foreground" Value="#16A34A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Planning">
                                    <Setter Property="Foreground" Value="#CA8A04"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

                        <Style x:Key="BudgetTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DataTextStyle}">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#10B981"/>
                        </Style>

                        <Style x:Key="ActionButtonStyle" TargetType="Button">
                            <Setter Property="Width" Value="60"/>
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Background" Value="#F3F4F6"/>
                            <Setter Property="BorderBrush" Value="#D1D5DB"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="#374151"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E5E7EB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <!-- GRID COLUMN DEFINITIONS -->
                        <GridLength x:Key="NameColumnWidth">2*</GridLength>
                        <GridLength x:Key="StandardColumnWidth">*</GridLength>
                        <GridLength x:Key="ActionColumnWidth">Auto</GridLength>

                        <!-- DATA TEMPLATE -->
                        <DataTemplate x:Key="EventItemTemplate">
                            <Border CornerRadius="6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Margin="0,0,0,10"
                                Background="White">

                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource NameColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource StandardColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource StandardColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource StandardColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource StandardColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource StandardColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource StandardColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource ActionColumnWidth}"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- EVENT DATA -->
                                    <TextBlock Grid.Column="0" 
                                       Text="{Binding Name}" 
                                       Style="{StaticResource NameTextStyle}"/>

                                    <TextBlock Grid.Column="1" 
                                       Text="{Binding Type}" 
                                       Style="{StaticResource DataTextStyle}"/>

                                    <TextBlock Grid.Column="2" 
                                       Text="{Binding DateTime}" 
                                       Style="{StaticResource DataTextStyle}"/>

                                    <TextBlock Grid.Column="3" 
                                       Text="{Binding Location}" 
                                       Style="{StaticResource DataTextStyle}"/>

                                    <TextBlock Grid.Column="4" 
                                       Text="{Binding Status}" 
                                       Style="{StaticResource StatusTextStyle}"/>

                                    <TextBlock Grid.Column="5" 
                                       Text="{Binding GuestSummary}" 
                                       Style="{StaticResource DataTextStyle}"/>

                                    <!-- Need to binding Budget-->
                                    <TextBlock Grid.Column="6"  
                                       Text="$10000" 
                                       Style="{StaticResource BudgetTextStyle}"/>

                                    <!-- ACTION BUTTONS -->
                                    <StackPanel Grid.Column="7" 
                                        Orientation="Vertical" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Center"
                                        Margin="12,0">

                                        <Button Content="Guests" 
                                            Style="{StaticResource ActionButtonStyle}"
                                            Command="{Binding DataContext.ViewGuestsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>

                                        <Button Content="Tasks" 
                                            Style="{StaticResource ActionButtonStyle}"
                                            Command="{Binding DataContext.ViewTasksCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </UserControl.Resources>

                    <!-- MAIN CONTENT -->
                    <StackPanel Margin="20">

                        <!-- SECTION TITLE -->
                        <TextBlock Text="Event List"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           Margin="0,0,0,20"/>

                        <!-- EVENTS LIST CONTAINER -->
                        <StackPanel>

                            <!-- HEADER -->
                            <Grid Background="#F9FAFB"
                              Margin="0,0,0,4"
                              HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource NameColumnWidth}"/>
                                    <ColumnDefinition Width="{StaticResource StandardColumnWidth}"/>
                                    <ColumnDefinition Width="{StaticResource StandardColumnWidth}"/>
                                    <ColumnDefinition Width="{StaticResource StandardColumnWidth}"/>
                                    <ColumnDefinition Width="{StaticResource StandardColumnWidth}"/>
                                    <ColumnDefinition Width="{StaticResource StandardColumnWidth}"/>
                                    <ColumnDefinition Width="{StaticResource StandardColumnWidth}"/>
                                    <ColumnDefinition Width="{StaticResource ActionColumnWidth}"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Column="2" Text="Date and Time" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Column="3" Text="Location" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Column="5" Text="Guest Summary" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Column="6" Text="Budget" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Grid.Column="7" Text="Actions" Style="{StaticResource HeaderTextStyle}"/>
                            </Grid>

                            <!-- EVENTS LIST -->
                            <ItemsControl ItemsSource="{Binding Events}"
                          ItemTemplate="{StaticResource EventItemTemplate}"/>
                        </StackPanel>
                    </StackPanel>
                </UserControl>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>