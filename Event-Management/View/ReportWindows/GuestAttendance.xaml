<UserControl x:Class="Event_Management.View.ReportWindows.GuestAttendance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Event_Management.View.ReportWindows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ReportStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F9FAFB">
        <StackPanel Margin="20">
            <!-- Header -->
            <TextBlock Text="Guest Attendance Report" Style="{StaticResource TitleText}" />
            <TextBlock Text="RSVP status and attendance tracking"
               Style="{StaticResource SubtitleText}"
               Margin="0,5,0,20" />

            <!-- DataGrid -->
            <DataGrid x:Name="attendanceGrid"
          AutoGenerateColumns="False"
          Style="{StaticResource EventsDataGrid}"
          RowStyle="{StaticResource SelectableRowStyle}"
          CellStyle="{StaticResource PlainDataGridCellStyle}"
          CanUserAddRows="False"
          CanUserResizeRows="False"
          GridLinesVisibility="None">


                <DataGrid.Columns>
                    <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="3*" />
                    <DataGridTextColumn Header="Invited" Binding="{Binding Invited}" Width="*" />
                    <DataGridTextColumn Header="Confirmed" Binding="{Binding Confirmed}" Width="1.5*" Foreground="Green"/>
                    <DataGridTextColumn Header="Declined" Binding="{Binding Declined}" Width="1.5*" Foreground="Red" />
                    <DataGridTextColumn Header="Pending" Binding="{Binding Pending}" Width="1.5*" Foreground="Brown"/>
                    <DataGridTextColumn Header="Reponse Rate" Binding="{Binding ResponseRate}" Width="1.5*" Foreground="Blue" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
