<UserControl x:Class="Event_Management.View.ReportWindows.GuestAttendance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Event_Management.View.ReportWindows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="\u23F0 Guest Attendance Report" FontSize="24" FontWeight="Bold" Margin="0 0 0 10"/>
            <TextBlock Text="RSVP status and attendance tracking" FontSize="14" Margin="0 0 0 20"/>
            <DataGrid x:Name="attendanceGrid" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="*"/>
                    <DataGridTextColumn Header="Invited" Binding="{Binding Invited}" Width="*"/>
                    <DataGridTextColumn Header="Confirmed" Binding="{Binding Confirmed}" Width="*"/>
                    <DataGridTextColumn Header="Declined" Binding="{Binding Declined}" Width="*"/>
                    <DataGridTextColumn Header="Pending" Binding="{Binding Pending}" Width="*"/>
                    <DataGridTextColumn Header="Response Rate" Binding="{Binding ResponseRate}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
