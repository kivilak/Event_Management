<UserControl x:Class="Event_Management.View.ReportWindows.EventSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Event_Management.View.ReportWindows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
 
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ReportStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F9FAFB">
        <StackPanel Margin="20">
            <!-- Header -->
            <TextBlock Text="Event Summary Report" Style="{StaticResource TitleText}" />
            <TextBlock Text="Overview of all events with key metrics"
                   Style="{StaticResource SubtitleText}"
                   Margin="0,5,0,20" />

            <!-- DataGrid -->
            <DataGrid x:Name="eventGrid"
              AutoGenerateColumns="False"
              Style="{StaticResource EventsDataGrid}"
              RowStyle="{StaticResource SelectableRowStyle}"
              CellStyle="{StaticResource PlainDataGridCellStyle}"
              CanUserAddRows="False"
              CanUserResizeRows="False"
              GridLinesVisibility="None">


                <DataGrid.Columns>
                    <DataGridTextColumn Header="EventName" Binding="{Binding EventName}" Width="3*" />
                    <DataGridTemplateColumn Header="Status" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Upcoming">
                                                    <Setter Property="Foreground" Value="#4361EE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Ongoing">
                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Planning">
                                                    <Setter Property="Foreground" Value="#CA8A04"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="Foreground" Value="#6B7280"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Guests" Binding="{Binding Guests}" Width="2*" />
                    <DataGridTextColumn Header="Budget" Binding="{Binding Budget}" Width="2*" />
                    <DataGridTextColumn Header="Spent" Binding="{Binding Spent}" Width="1.5*" />
                    <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining}" Width="1.5*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
