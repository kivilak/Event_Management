<Window x:Class="Event_Management.View.window.AddEvent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Event_Management.View.window"
        mc:Ignorable="d"
        Title="Add New Event"
        WindowState="Maximized"
        WindowStyle="ThreeDBorderWindow">



    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Main Form Content -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="20">
            <StackPanel Orientation="Vertical">

                <!-- Basic Event Information -->
                <GroupBox Header="Basic Event Information" Margin="0,0,0,15" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--Event Name-->
                        <Label Content="Event Name *" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="0" Grid.Column="0" Margin="0,25,10,15" Text="{Binding EventName, UpdateSourceTrigger=PropertyChanged}" Height="30" />

                        <!--Event Type-->
                        <Label Content="Event Type *" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
                        <ComboBox  ItemsSource="{Binding EventTypeOptions}"  Grid.Row="0" Grid.Column="1" Margin="0,25,0,15" SelectedItem="{Binding EventType , Mode=TwoWay}" Height="30" FontSize="14"
                          BorderBrush="#D0D7DE" BorderThickness="1"
                          Background="#FAFBFC" Foreground="Black"/>

                        <!--Category and Tags-->
                        <Label Content="Category" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Margin="0,25,10,15" Text="{Binding Category}" Height="30"/>

                        <Label Content="Tags (comma-separated)" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,25,0,15" Text="{Binding Tags}" Height="30"
                                 ToolTip="Enter tags separated by commas (e.g., technology, networking, professional)"/>

                        <!--Description-->
                        <Label Content="Description" Grid.Row="2" Grid.ColumnSpan="2" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="3" Grid.ColumnSpan="2" Height="80" AcceptsReturn="True"
                                 TextWrapping="Wrap" Margin="0,0,0,0" Text="{Binding Description}"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </GroupBox>

                <!-- Date and Time Information -->
                <GroupBox Header="Date and Time" Margin="0,0,0,15" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Content="Event Date *" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold"/>
                        <DatePicker Grid.Row="1" Grid.Column="0" SelectedDate="{Binding EventDate}" Margin="0,0,10,15" Height="30"/>

                        <Label Content="Start Time *" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StartTime}" Margin="0,0,10,15" Height="30"
                                 ToolTip="Format: HH:MM (e.g., 14:30)"/>

                        <Label Content="End Time *" Grid.Row="0" Grid.Column="2" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding EndTime}" Margin="0,0,0,15" Height="30"
                                 ToolTip="Format: HH:MM (e.g., 16:30)"/>

                    </Grid>
                </GroupBox>

                <!-- Venue Information -->
                <GroupBox Header="Venue Information" Margin="0,0,0,15" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Content="Venue Name *" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="0" Grid.Column="0" Margin="0,25,10,15" Text="{Binding VenueName}" Height="30"/>

                        <Label Content="Street Address *" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,25,0,15" Text="{Binding StreetAddress}" Height="30"/>

                        <Label Content="City *" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Margin="0,25,10,15" Text="{Binding City}" Height="30"/>

                        <Label Content="State/Province *" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,25,0,15" Text="{Binding State}" Height="30"/>

                    </Grid>
                </GroupBox>

                <!-- Capacity and Registration -->
                <GroupBox Header="Capacity and Registration" Margin="0,0,0,15" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Content="Maximum Capacity *" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="0" Grid.Column="0" Margin="0,25,10,15" Text="{Binding MaximumCapacity}" Height="30"/>

                        <Label Content="Current Registrations" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,25,0,15" IsReadOnly="True" Text="{Binding CurrentRegistrations}" 
                                 Height="30" Background="#F5F5F5"/>

                        <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="Allow waitlist when capacity is reached" 
                                  IsChecked="{Binding AllowWaitlist}" Margin="0,10,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- Contact Information -->
                <GroupBox Header="Contact Information" Margin="0,0,0,15" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Content="Contact Email *" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="0" Grid.Column="0" Margin="0,25,10,15" Text="{Binding Email}" Height="30"/>

                        <Label Content="Event Website" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,25,0,15" Text="{Binding Website}" Height="30"/>

                        <Label Content="Phone Number" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Margin="0,25,10,0" Text="{Binding Phone}" Height="30"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Right Sidebar -->
        <Border Grid.Column="1" Background="#F8F9FA" Margin="0,20,20,20" CornerRadius="5">
            <StackPanel Margin="15">

                <!-- Pricing Section -->
                <GroupBox Header="Pricing Tiers" Margin="0,0,0,15" Padding="10">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Regular Price" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Text="{Binding RegularPrice}" Height="25"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Early Bird Price" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Text="{Binding EarlyBirdPrice}" Height="25"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="VIP Price" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Text="{Binding VipPrice}" Height="25"/>
                        </Grid>

                        <CheckBox Content="Free Event" IsChecked="{Binding IsFreeEvent}" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Action Buttons -->
                <StackPanel Margin="0,20,0,0">
                    <Button Content="Save Event"
                            Width="150"
                            Height="40"
                            Margin="0,0,0,10"
                            Background="#28a745"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            Command="{Binding SaveCommand}"/>

                    <Button Content="Clear Form"
                            Width="150"
                            Height="35"
                            Background="#dc3545"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Command="{Binding ClearCommand}"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
