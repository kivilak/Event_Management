<Window x:Class="Event_Management.View.window.AddGuest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Event_Management.View.window"
        mc:Ignorable="d"
        Title="Add New Guest" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,30">
            <Button Content="←" FontSize="18" FontWeight="Bold" Background="Transparent" 
                    BorderThickness="0" Padding="10,5" VerticalAlignment="Center"/>
            <TextBlock Text="Add New Guest" FontSize="28" FontWeight="Bold" Margin="10,0,0,0" 
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Column="0" Margin="0,50,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Adding guest to text -->
            <TextBlock Grid.Row="0" Text="Adding guest to Annual Tech Conference 2024" 
                       FontSize="14" Foreground="Gray" Margin="0,0,0,20"/>

            <!-- Guest Information Card -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="30">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" Color="LightGray" Opacity="0.3" BlurRadius="5"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Guest Information Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <Ellipse Width="8" Height="8" Fill="#4A90E2" VerticalAlignment="Center"/>
                        <TextBlock Text="Guest Information" FontSize="18" FontWeight="SemiBold" 
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Tab Headers -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="👤 Personal"  
                                    Background="#E6F3FF" Foreground="#4A90E2" Margin="0,0,20,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Form Fields -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <!-- For RSVP -->
                        </Grid.RowDefinitions>

                        <!-- First Name -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="First Name" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="*" Foreground="Red" FontSize="12" Margin="0,-20,0,8" 
                                       HorizontalAlignment="Right"/>
                            <TextBox x:Name="FirstNameTextBox" Height="45" Padding="15,12" 
                                     FontSize="14" BorderBrush="#E0E0E0" BorderThickness="1"
                                      Foreground="Gray"/>
                        </StackPanel>

                        <!-- Last Name -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Last Name" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="*" Foreground="Red" FontSize="12" Margin="0,-20,0,8" 
                                       HorizontalAlignment="Right"/>
                            <TextBox x:Name="LastNameTextBox" Height="45" Padding="15,12" 
                                     FontSize="14" BorderBrush="#E0E0E0" BorderThickness="1"
                                      Foreground="Gray"/>
                        </StackPanel>

                        <!-- Email Address -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Email Address" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="*" Foreground="Red" FontSize="12" Margin="0,-20,0,8" 
                                       HorizontalAlignment="Right"/>
                            <Grid>
                                <TextBox x:Name="EmailTextBox" Height="45" Padding="40,12,15,12" 
                                         FontSize="14" BorderBrush="#E0E0E0" BorderThickness="1"
                                         Foreground="Gray"/>
                                <TextBlock Text="✉" FontSize="16" Foreground="Gray" 
                                           VerticalAlignment="Center" HorizontalAlignment="Left" 
                                           Margin="15,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Phone Number -->
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Phone Number" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <TextBox x:Name="PhoneTextBox" Height="45" Padding="40,12,15,12" 
                                         FontSize="14" BorderBrush="#E0E0E0" BorderThickness="1"
                                          Foreground="Gray"/>
                                <TextBlock Text="📞" FontSize="16" Foreground="Gray" 
                                           VerticalAlignment="Center" HorizontalAlignment="Left" 
                                           Margin="15,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Guest Category -->
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Guest Category" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CategoryComboBox" Height="45" Padding="15,0" FontSize="14"
                                      BorderBrush="#E0E0E0" BorderThickness="1" Foreground="Gray"
                                      SelectedIndex="-1">
                                <ComboBoxItem IsEnabled="False" IsSelected="True" Content="Select category"/>
                                <ComboBoxItem Content="VIP"/>
                                <ComboBoxItem Content="Speaker"/>
                                <ComboBoxItem Content="Sponsor"/>
                                <ComboBoxItem Content="Media"/>
                                <ComboBoxItem Content="Staff"/>
                                <ComboBoxItem Content="General Attendee"/>
                                <ComboBoxItem Content="Family"/>
                                <ComboBoxItem Content="Plus One"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Job Title -->
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Job Title" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="JobTitleTextBox" Height="45" Padding="15,12" 
                                     FontSize="14" BorderBrush="#E0E0E0" BorderThickness="1"
                                      Foreground="Gray"/>
                        </StackPanel>

                        <!-- RSVP Status -->
                        <StackPanel Grid.Row="6" Grid.Column="0">
                            <TextBlock Text="RSVP Status" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox x:Name="RsvpComboBox" Height="45" Padding="15,0" FontSize="14"
                                      BorderBrush="#E0E0E0" BorderThickness="1" Foreground="Gray"
                                      SelectedIndex="-1">
                                <ComboBoxItem IsEnabled="False" IsSelected="True" Content="Select RSVP status"/>
                                <ComboBoxItem Content="Pending"/>
                                <ComboBoxItem Content="Accepted"/>
                                <ComboBoxItem Content="Declined"/>
                            </ComboBox>
                        </StackPanel>
                            
                        </Grid>
                        <!-- Save Button -->
                        <Button Content="Save Guest"
                            Width="150"
                            Height="45"
                            Margin="0,30,0,0"
                            HorizontalAlignment="Right"
                            Background="#4A90E2"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SaveButton_Click"/>
                    </StackPanel>
            </Border>
        </Grid>

        <!-- Selected Event Card -->
        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" 
                Margin="0,50,0,0" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" Color="LightGray" Opacity="0.3" BlurRadius="5"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Selected Event" FontSize="16" FontWeight="SemiBold" 
                           Foreground="#4A90E2" Margin="0,0,0,20"/>

                <!-- Event Details -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Annual Tech Conference 2024" FontSize="16" FontWeight="SemiBold" 
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="🇺🇸" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="3/15/2024" FontSize="14" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📍" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Convention Center" FontSize="14" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>

                <!-- Guest Summary -->
                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Guest Summary" FontSize="16" FontWeight="SemiBold" 
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="SemiBold" 
                                       Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Not provided" 
                                       Foreground="Gray" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Event:" FontWeight="SemiBold" 
                                       Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Annual Tech Conference 2024" 
                                       Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Category:" FontWeight="SemiBold" 
                                       Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="RSVP:" FontWeight="SemiBold" 
                                       Margin="0,0,10,0"/>
                            <Border Grid.Row="3" Grid.Column="1" Background="#FFF3CD" 
                                    CornerRadius="12" Padding="8,4" HorizontalAlignment="Left">
                                <TextBlock Text="pending" FontSize="12" Foreground="#856404"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
        </ScrollViewer>
        <!-- Window Resources -->
    <Window.Resources>
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>
