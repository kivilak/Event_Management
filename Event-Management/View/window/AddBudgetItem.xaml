<Window x:Class="Event_Management.View.window.AddBudgetItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Budget Item" 
        Height="520" Width="700" 
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <Border CornerRadius="10" BorderBrush="#DDDDDD" BorderThickness="1" Padding="20" Background="White" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Center">
                <TextBlock Text="Add New Budget Item" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="#2E86DE"
                           Margin="0,0,0,5" />
                <Rectangle Height="3" Width="200" Fill="#2E86DE" RadiusY="2" RadiusX="2"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <!-- Category -->
                <StackPanel Margin="0,10">
                    <TextBlock Text="Category" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource {x:Static ToolBar.TextBoxStyleKey}}"
                             ToolTip="Enter the category (e.g., Venue, Catering)"
                             Padding="6"
                             BorderBrush="#CCC" BorderThickness="1" 
                             Background="#FDFDFD" Width="398" />
                </StackPanel>

                <!-- Event -->
                <StackPanel Margin="0,10">
                    <TextBlock Text="Event" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBox Text="{Binding EventName, UpdateSourceTrigger=PropertyChanged}" 
                             ToolTip="Enter the related event name"
                             Padding="6"
                             BorderBrush="#CCC" BorderThickness="1" 
                             Background="#FDFDFD" />
                </StackPanel>

                <!-- Estimated -->
                <StackPanel Margin="0,10">
                    <TextBlock Text="Estimated Cost" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBox Text="{Binding  summary.TotalBudget, UpdateSourceTrigger=PropertyChanged}" 
                             ToolTip="Enter the estimated amount (numeric)"
                             Padding="6"
                             BorderBrush="#CCC" BorderThickness="1" 
                             Background="#FDFDFD" />
                </StackPanel>

                <!-- Actual -->
                <StackPanel Margin="0,10">
                    <TextBlock Text="Actual Cost" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBox Text="{Binding  summary.Spent, UpdateSourceTrigger=PropertyChanged}" 
                             ToolTip="Enter the actual amount spent (numeric)"
                             Padding="6"
                             BorderBrush="#CCC" BorderThickness="1" 
                             Background="#FDFDFD" />
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,0" >

                <Button Content="Add Item" 
                        Command="{Binding AddItemCommand}" 
                        Width="140" Height="40"
                        Background="#2E86DE" Foreground="White"
                        FontWeight="Bold" 
                        Cursor="Hand"
                        BorderBrush="#2E86DE" 
                        BorderThickness="0" RenderTransformOrigin="0.038,0.566"
                        Click="AddItem_Click"
                        >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="#2E86DE"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#2E86DE"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="0" 
                                                Padding="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1B4F72"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Cancel" 
                        Width="100" Height="40"
                        Background="#EAEAEA"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        FontWeight="Bold"
                        Foreground="#333"
                        Cursor="Hand"
                        Click="Cancel_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="1" 
                                                Padding="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D6D6D6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
