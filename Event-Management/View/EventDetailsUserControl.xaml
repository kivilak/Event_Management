<UserControl x:Class="Event_Management.View.EventDetailsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Event_Management.View"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="#F9FAFB">
        <StackPanel Margin="30">

            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Section -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Back Button -->
                    <Button Content="← Back "
                        Width="150"
                        Height="40"
                        Margin="0,0,20,0"
                        FontWeight="SemiBold"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        Foreground="#111827"
                        BorderThickness="1"
                        Padding="10,0" 
                        Click="BackButton_Click"/>

                <!-- Header Texts -->
                <StackPanel>
                        <TextBlock Text="Guest Management"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#111827" />
                        <TextBlock>
                        <Run Text="Managing guests for " />
                        <Run Text="{Binding Name}" Foreground="#374151" />
                        <Run Text="&quot;" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Right Section -->
                <StackPanel Orientation="Horizontal"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    >

                    <!-- Export Button -->
                    <Button Content="Export"
                        Width="100"
                        Height="40"
                        FontWeight="SemiBold"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        Foreground="#111827"
                        BorderThickness="1" />

                    <!-- Add Guest Button with Gradient -->
                    <Button Width="120"
                        Height="40"
                        FontWeight="SemiBold"
                        Foreground="White"
                        BorderThickness="0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1E293B" Offset="0.0" />
                                <GradientStop Color="#9CA3AF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="+" FontSize="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Add Guest"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>


            <!-- Event Info Card -->
            <Border CornerRadius="10"
                Background="#F0FDFA"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                Padding="20"
                Margin="0,10,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Event Details -->
                    <StackPanel Orientation="Vertical" Grid.Column="0">
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="#111827"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="📅" FontSize="14"/>
                            <TextBlock Text="{Binding DateTime}" Foreground="#374151" Margin="5,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="📍" FontSize="14"/>
                            <TextBlock Text="{Binding Location}" Foreground="#374151" Margin="5,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Type}" Foreground="#111827" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <Border Background="#E0E7FF" CornerRadius="8" Padding="6,2">
                                <TextBlock Text="{Binding Status}" 
                               Foreground="#3730A3"
                               FontWeight="Bold"
                               FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Guest Count -->
                    <StackPanel Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="30,0,0,0">
                        <TextBlock>
                <Run Text="{Binding Guests}" FontWeight="Bold" Foreground="#2563EB" FontSize="16"/>
                <Run Text="/" FontWeight="Bold" Foreground="#2563EB" FontSize="16"/>
                <Run Text="{Binding Capacity}" FontWeight="Bold" Foreground="#2563EB" FontSize="16"/>
                        </TextBlock>
                        <TextBlock Text="Guests" Foreground="#6B7280" FontSize="12" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- Stats Section -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Guests -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL GUESTS" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Guests}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="{Binding Capacity, StringFormat={}of {0} capacity}" FontSize="12" Foreground="#9CA3AF"/>
                    </StackPanel>
                </Border>

                <!-- Confirmed Guests -->
                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="CONFIRMED" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock Text="1" FontSize="22" FontWeight="Bold" Foreground="#10B981"/>
                    </StackPanel>
                </Border>

                <!-- Pending Guests -->
                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="PENDING" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock Text="1" FontSize="22" FontWeight="Bold" Foreground="#F59E0B"/>
                    </StackPanel>
                </Border>

                <!-- Checked In -->
                <Border Grid.Column="3" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CHECKED IN" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock Text="0" FontSize="22" FontWeight="Bold" Foreground="#8B5CF6"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
