<UserControl x:Class="Event_Management.View.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F8FAFC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- Header -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Welcome back! Here's what's happening with your events."
                               Foreground="#64748B" FontSize="14"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Width="140" Height="40" Background="#2563EB" Foreground="White"
                        FontWeight="SemiBold" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="+" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Create Event" FontSize="14"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Summary Cards -->
            <UniformGrid Columns="3" Margin="0,0,0,30" HorizontalAlignment="Stretch">

                <!-- Total Events -->
                <Border CornerRadius="10" Background="White" Padding="20" Margin="10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Total Events" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="12" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="+2 from last month" Foreground="#16A34A" FontSize="13" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tasks Progress -->
                <Border CornerRadius="10" Background="White" Padding="20" Margin="10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Tasks Progress" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="65%" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="23 of 35 tasks completed" Foreground="#2563EB" FontSize="13" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Budget Status -->
                <Border CornerRadius="10" Background="White" Padding="20" Margin="10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Budget Status" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="72%" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="$144K of $200K used" Foreground="#EA580C" FontSize="13" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Recent Events Section -->
            <Border CornerRadius="10" Background="White" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Recent Events" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Manage and track your upcoming events"
                               Foreground="#64748B" FontSize="13" Margin="0,2,0,15"/>

                    <!-- Search + Filter -->
                    <DockPanel Margin="0,0,0,15">
                        <TextBox Width="250" Height="35" 
                                 VerticalContentAlignment="Center" 
                                 Padding="10,0,0,0"
                                 Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                 Tag="Search events..." />
                        <ComboBox Width="150" Height="35" Margin="10,0,0,0" SelectedIndex="0"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="All Status" IsSelected="True"/>
                            <ComboBoxItem Content="Upcoming"/>
                            <ComboBoxItem Content="Completed"/>
                            <ComboBoxItem Content="Cancelled"/>
                        </ComboBox>
                    </DockPanel>

                    <!-- Event Table -->
                    <DataGrid AutoGenerateColumns="False"
          HeadersVisibility="Column"
          CanUserAddRows="False"
          Background="White"
          BorderBrush="#E2E8F0"
          BorderThickness="1"
          RowHeight="40"
          ColumnHeaderHeight="40"
          AlternatingRowBackground="#F9FAFB"
          GridLinesVisibility="None">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Event Name" Binding="{Binding Name}" Width="3*"/>
                            <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding DateTime}" Width="2*"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="3*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*"/>
                            <DataGridTextColumn Header="Attendees" Binding="{Binding Attendees}" Width="2*"/>
                            <DataGridTemplateColumn Header="Actions" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View Details"
                            Width="100" Height="28"
                            Background="#F1F5F9"
                            BorderBrush="#E2E8F0"
                            Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
