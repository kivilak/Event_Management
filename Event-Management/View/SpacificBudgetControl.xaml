<UserControl x:Class="Event_Management.View.SpacificBudgetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Event_Management.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/BudgetStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
               HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#F7F9FC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Cards -->
                <RowDefinition Height="Auto"/>
                <!-- Budget Utilization -->
                <RowDefinition Height="Auto"/>
                <!-- Graph section -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- Header and Add Button -->
            <Grid Grid.Row="0" Margin="10,0,10,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Budget Tracker" Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="{Binding EventName}" Style="{StaticResource SubHeaderText}"/>
                    </StackPanel>
                    <TextBlock Text="Monitor event expenses and budget allocation"
                        Style="{StaticResource SubHeaderText}"/>
                </StackPanel>

                <Button Grid.Column="1" Width="160" Style="{StaticResource AddButton}" Margin="10,0,0,0"
                        Click="AddBugdetBtn_Click"
                        >
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- <Image Source="../Assets/plus.png" Width="16" Height="16" Margin="0,0,5,0"/> -->
                        <TextBlock Text="Add Budget Item"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!--  Budget Cards -->
            <Grid Grid.Row="1" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Budget -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Budget" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Summary.TotalBudget, StringFormat='${0:N0}'}" Style="{StaticResource CardValue}" />
                            <!--<Image Source="../Assets/trending-up.png" Width="20" Height="20" Margin="5,0,0,0"/> -->
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.TotalBudget, StringFormat='${0:N0}'}" Style="{StaticResource CardSubText}" />
                    </StackPanel>
                </Border>

                <!-- Spent -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Spent" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Summary.Spent, StringFormat='${0:N0}'}" Style="{StaticResource CardValue}" />
                            <!--<Image Source="../Assets/trending-down.png" Width="20" Height="20" Margin="5,0,0,0"/> -->
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.Spent, StringFormat='${0:N0}'}" Style="{StaticResource CardSubText}" />
                    </StackPanel>
                </Border>

                <!-- Remaining -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Remaining" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Summary.Remaining, StringFormat='${0:N0}'}" Foreground="Green" Style="{StaticResource CardValue}" />
                            <!-- <Image Source="../Assets/check.png" Width="20" Height="20" Margin="5,0,0,0"/> -->
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.Remaining, StringFormat='${0:N0}'}" Style="{StaticResource CardSubText}" />
                    </StackPanel>
                </Border>

                <!-- Over Budget -->
                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Over Budget" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Summary.OverBudgetItems, StringFormat='{}{0:N0}'}" Foreground="Red" Style="{StaticResource CardValue}" />
                            <!-- <Image Source="../Assets/warning.png" Width="20" Height="20" Margin="5,0,0,0"/> -->
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.OverBudgetItems, StringFormat='{}{0:N0}'}" Style="{StaticResource CardSubText}" />
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Budget Utilization Section -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10" Margin="20,0,20,0"
     BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Budget Utilization" Style="{StaticResource HeaderText2}" />
                    <TextBlock Text="Overall budget usage across all events" 
                Style="{StaticResource SubHeaderText}" Margin="0,0,0,10" />

                    <!-- Summary Row -->
                    <Grid Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left side: "42,500 of 45,000 used" -->
                        <TextBlock Grid.Column="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#1F2937"
                        VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:C0} of {1:C0} used">
                                    <!-- Use TargetNullValue to avoid errors if null -->
                                    <Binding Path="Summary.Spent" TargetNullValue="0" />
                                    <Binding Path="Summary.TotalBudget" TargetNullValue="0" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- Right side: "94.44%" -->
                        <TextBlock Grid.Column="1"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#2563EB"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{Binding Summary.PercentageOfSpent, 
                                       TargetNullValue=0, 
                                       StringFormat={}{0:F2}%}" />
                    </Grid>


                    <!-- Warning Box -->
                    <Border Background="#FFF5F5" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,5,0,0">
                        <StackPanel Orientation="Horizontal">
                            <!--<Image Source="../Assets/warning.png" Width="20" Height="20" Margin="0,0,10,0"/> -->
                            <TextBlock Text="Warning: Budget utilization is high. Consider reviewing expenses."
                        Foreground="#B91C1C" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="10" Margin="20,20,20,0"
     BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel Margin="20">
                    <!-- Header -->
                    <TextBlock Text="Budgets Items" Style="{StaticResource TitleText}" />

                    <!-- Filters -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,15" VerticalAlignment="Center" >
                        <ComboBox Style="{StaticResource StyledComboBox}" Width="210">
                            <ComboBoxItem Content="All Events" IsSelected="True"/>
                            <ComboBoxItem Content="Tech Conference 2024"/>
                            <ComboBoxItem Content="Product Launch"/>
                            <ComboBoxItem Content="Wedding Reception"/>
                        </ComboBox>

                    </StackPanel>
                    <DataGrid x:Name="BudgetItemsGrid" 
                           ItemsSource="{Binding BudgetItems}"
                           AutoGenerateColumns="False"
                           Style="{StaticResource EventsDataGrid}"
                           RowStyle="{StaticResource SelectableRowStyle}"
                           CellStyle="{StaticResource PlainDataGridCellStyle}"
                           CanUserAddRows="False"
                           CanUserResizeRows="False"
                           GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="2*" />
                            <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="2*" />
                            <DataGridTextColumn Header="Estimated" Binding="{Binding Estimated}" Width="2*" />
                            <DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="1.5*" />
                            <DataGridTextColumn Header="Difference" Binding="{Binding Difference}" Width="2*" />

                            <DataGridTemplateColumn Header="Status" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Over Budget">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Under Budget">
                                                            <Setter Property="Foreground" Value="Green"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Foreground" Value="black"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Budget Distribution Card -->
                <Border Grid.Column="0" Style="{StaticResource ChartCard}"  Margin="20,20,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <!--<Image Source="../Assets/pie-chart.png" Width="20" Height="20" Margin="0,0,5,0"/> -->
                            <TextBlock Text="Budget Distribution" Style="{StaticResource ChartCardTitle}" />
                        </StackPanel>

                        <!-- <Image Source="../Assets/pie-placeholder.png" Width="80" Height="80" Margin="20" Opacity="0.5"/> -->
                        <TextBlock Text="Pie chart visualization would be rendered here"
                        Style="{StaticResource ChartDescription}" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Estimated vs Actual Card -->
                <Border Grid.Column="1" Style="{StaticResource ChartCard}" Margin="20,20,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <!--<Image Source="../Assets/bar-chart.png" Width="20" Height="20" Margin="0,0,5,0"/> -->
                            <TextBlock Text="Estimated vs Actual" Style="{StaticResource ChartCardTitle}" />
                        </StackPanel>

                        <!-- <Image Source="../Assets/bar-placeholder.png" Width="80" Height="80" Margin="20" Opacity="0.5"/> -->
                        <TextBlock Text="Bar chart visualization would be rendered here"
                        Style="{StaticResource ChartDescription}" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>

</UserControl>
