<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Header Text -->
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        
    </Style>
    <!--Header Text 2-->
    <Style x:Key="HeaderText2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
        <Setter Property="Foreground" Value="#1F2937"/>

    </Style>

    <!-- SubHeader Text -->
    <Style x:Key="SubHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card Title -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#374151"/>
    </Style>

    <!-- Card Value -->
    <Style x:Key="CardValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <!-- Card SubText -->
    <Style x:Key="CardSubText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Add Button -->
    <Style x:Key="AddButton" TargetType="Button">
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Title Text Style -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>

    <!-- Styled ComboBox -->
    <Style x:Key="StyledComboBox" TargetType="ComboBox">
        <Setter Property="Width" Value="250"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Chart Card Container -->
    <Style x:Key="ChartCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="280"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <!-- Title in Card -->
    <Style x:Key="ChartCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Description under icon -->
    <Style x:Key="ChartDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <!-- Main Card Style -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="#DDD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <!-- Text Styles -->
    <Style x:Key="TitleText2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#222"/>
    </Style>

    <Style x:Key="ItemTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#333"/>
    </Style>

    <Style x:Key="ItemValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#444"/>
    </Style>

    <Style x:Key="SubText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="Gray"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- ProgressBars -->
    <Style x:Key="GreenProgress" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="#22C55E"/>
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="YellowProgress" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="#EAB308"/>
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Summary Cards -->
    <Style x:Key="SummaryBox" TargetType="Border">
        <Setter Property="Background" Value="#F8F8F8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="SummaryBoxBlue" TargetType="Border" BasedOn="{StaticResource SummaryBox}">
        <Setter Property="Background" Value="#EEF4FF"/>
    </Style>

    <Style x:Key="SummaryBoxGreen" TargetType="Border" BasedOn="{StaticResource SummaryBox}">
        <Setter Property="Background" Value="#ECFDF5"/>
    </Style>

    <Style x:Key="SummaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#222"/>
    </Style>

    <Style x:Key="SummaryAmount" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#222"/>
    </Style>

    <Style x:Key="SummaryAmountBlue" TargetType="TextBlock" BasedOn="{StaticResource SummaryAmount}">
        <Setter Property="Foreground" Value="#2563EB"/>
    </Style>

    <Style x:Key="SummaryAmountGreen" TargetType="TextBlock" BasedOn="{StaticResource SummaryAmount}">
        <Setter Property="Foreground" Value="#16A34A"/>
    </Style>


</ResourceDictionary>
