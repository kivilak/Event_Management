<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <DropShadowEffect x:Key="DefaultDropShadow" Color="Black" Opacity="0.3" ShadowDepth="3" BlurRadius="8" Direction="315" />
    <DropShadowEffect x:Key="StrongDropShadow" Color="Black" Opacity="0.5" ShadowDepth="3" BlurRadius="8" Direction="315" />
    <DropShadowEffect x:Key="SubtleDropShadow" Color="Black" Opacity="0.5" ShadowDepth="3" BlurRadius="8" Direction="315" />
    
    <Style x:Key="NavigationStyle" TargetType="StackPanel">
        <Setter Property="Background" Value="White"/>
    </Style>
    
    <Style x:Key="DashboardStyle" TargetType="Grid">
        <Setter Property="Background" Value="#FFF1F1F1" />
    </Style>
    
    <Style x:Key="TitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="10" />
    </Style>
    
    <Style x:Key="NavigationButton" TargetType="Button">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Gray" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="10, 5" />
        <Setter Property="Margin" Value="5, 10, 5, 0" />
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="40" />
        <Setter Property="BorderBrush" Value="#FF4646FF" />
        <Setter Property="BorderThickness" Value="0, 0, 5, 0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Effect="{TemplateBinding Effect}">
                        <ContentPresenter HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F0F0F0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActiveNavigationButton" TargetType="Button">
        <Setter Property="Background" Value="#FFE7F9FF" />
        <Setter Property="Foreground" Value="#FF4646FF" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="10, 5" />
        <Setter Property="Margin" Value="5, 10, 5, 0" />
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="40" />
        <Setter Property="BorderBrush" Value="#FF4646FF" />
        <Setter Property="BorderThickness" Value="0, 0, 5, 0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="{TemplateBinding BorderThickness}"
                         CornerRadius="5"
                         Effect="{TemplateBinding Effect}">
                        <ContentPresenter HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>